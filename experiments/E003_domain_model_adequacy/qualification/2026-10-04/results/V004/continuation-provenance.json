    "experiments\\E003_domain_model_adequacy\\qualification\\2026-10-04\\V004-continuation.md": {
      "content": "# V004 authorization record\n\nUser authorization: continue the unfinished E003 scientific audit in a new recorded run while preserving V002 as `77/162 PARTIAL`.\n\nV004 follows V003's preflight block caused by an `EINVAL` read from Google Drive while hashing `Bank.zip`. V003 has zero inherited and zero completed profiles. V004 has no scientific-protocol change. It adds only bounded, resumable read retries for the G: streamed-file hash. A matching SHA-256 remains required before checkpoint reuse or audit execution.\n\nCommand:\n\n`$env:PYTHONPATH='src'; .\\.venv-e002\\Scripts\\python.exe -m dce_foundation.qualification.continuation_run --config experiments/E003_domain_model_adequacy/qualification/2026-10-04/continuation-V004/configuration.json --inherit-completed-from experiments/E003_domain_model_adequacy/qualification/2026-10-04/results/V002 --output experiments/E003_domain_model_adequacy/qualification/2026-10-04/results/V004`\n\nNew logs are `logs/V004-stdout.log` and `logs/V004-stderr.log`. Stop after report and independent validation for human review; do not start remediation, RCA reasoning, RCAEval, or data deletion.\n",
      "sha256": "83c65b7a41f988a1781185b19f32bc4aec331a03053b2391aa986bcf01990a2d"
    },
    "tests\\test_e003_checkpoint_continuation.py": {
      "content": "import json\nimport sqlite3\nimport zlib\nimport pytest\nfrom dce_foundation.qualification.compact import SCHEMA\nfrom dce_foundation.qualification.continuation_run import inherit_blocks\nfrom dce_foundation.domain import canonical_json\nfrom dce_foundation.inspection import file_hash\n\n\n@pytest.mark.parametrize('bad_count', [False, True])\ndef test_completed_blocks_only_and_parent_untouched(tmp_path, bad_count):\n    old = tmp_path/'old'\n    old.mkdir()\n    parent = old/'context.sqlite'\n    db = sqlite3.connect(parent)\n    db.executescript(SCHEMA)\n    for i in range(1,78):\n        p = {'source_key':str(i),'path':f'file{i}','scenario':'Bank','decision':'QUALIFIED',\n             'crc_eof_verified':True,'row_conservation':True,'decompressed_sha256':'fixture',\n             'selection_counts':{'mapped':(2 if bad_count else 1) if i==1 else 0}}\n        (old/f'file-{i:03d}.json').write_text(json.dumps(p))\n        db.execute('INSERT INTO sources VALUES (?,?,?,?,?)',(str(i),'Bank',p['path'],'QUALIFIED',canonical_json(p)))\n    body=zlib.compress(b'[[1,2,\"mapped\",null,{\"value\":\"1\"}]]')\n    for key in ('1','incomplete'):\n        db.execute('INSERT INTO blocks(source_key,environment,signal,min_ns,max_ns,records,payload) VALUES (?,?,?,?,?,?,?)',\n                   (key,'Bank','metric',1,1,1,body))\n    db.commit()\n    db.close()\n    before=file_hash(parent)\n    output=tmp_path/'new'\n    output.mkdir()\n    new=sqlite3.connect(output/'context.sqlite')\n    new.executescript(SCHEMA)\n    if bad_count:\n        with pytest.raises(ValueError, match='conservation'):\n            inherit_blocks(old,new,output)\n    else:\n        assert len(inherit_blocks(old,new,output))==77\n        assert new.execute('SELECT source_key,payload FROM blocks').fetchall()==[('1',body)]\n        assert len(list(output.glob('file-*.json')))==77\n    new.close()\n    assert file_hash(parent)==before\n",
      "sha256": "1cbd0ccc845e1a9b491775a02dfb82b3f8a03b539b84624f1da0ec4493df5d6d"
    }
  },
